# Password for the Postgres user "capture" (database: robot_capture).
# Used by both the postgres container and the ingest service — set this once only.
# Dev: "changeme" is fine. Production: use a long random secret.
# Note: password is applied on first DB init only. To change it later, run
#       `docker compose down -v` (deletes DB data) or alter the role in Postgres.
# If the password contains @ : / # etc., URL-encode it (compose builds DATABASE_URL).
POSTGRES_PASSWORD=changeme

# Where JPEGs and manifest.json files are stored inside the ingest container.
STORAGE_ROOT=/data/captures

# Optional comma-separated API keys. When set, robots/operators must send X-Api-Key
# on all routes except GET /health. Leave empty to disable auth (dev only).
API_KEYS=

# Archive pose chunk files under STORAGE_ROOT/poses/ (default true). DB insert always runs.
# POSE_ARCHIVE=true

# Optional: host directory bind-mounted to STORAGE_ROOT (compose volume for ingest).
# CAPTURE_DATA_DIR=./data/captures
